# Required
BOT_TOKEN=replace_with_telegram_bot_token
OPENAI_API_KEY=replace_with_openai_api_key
POSTGRES_USER=bot_user
POSTGRES_PASSWORD=replace_with_strong_database_password
POSTGRES_DB=telegram_ai_bot

# Database URLs. Keep the hostname "db" when running through Docker Compose.
DATABASE_URL=postgresql+asyncpg://bot_user:replace_with_strong_database_password@db:5432/telegram_ai_bot
DATABASE_URL_SYNC=postgresql+psycopg2://bot_user:replace_with_strong_database_password@db:5432/telegram_ai_bot

# AI and conversation settings
OPENAI_MODEL=gpt-4o-mini
WHISPER_MODEL=whisper-1
MAX_CONTEXT_MESSAGES=20
MAX_DOCUMENT_CHARS=12000
MAX_UPLOAD_BYTES=20971520

# Administration and subscription
ADMIN_IDS=123456789
PREMIUM_PRICE_STARS=100
PREMIUM_DURATION_DAYS=30

# Environment: development starts polling and creates tables; production expects Alembic migrations.
ENVIRONMENT=development
USE_WEBHOOK=false
WEBHOOK_URL=https://your-domain.example
WEBHOOK_PATH=/webhook
WEBHOOK_SECRET=replace_with_a_long_random_secret
DOMAIN=your-domain.example
CERTBOT_EMAIL=you@example.com

